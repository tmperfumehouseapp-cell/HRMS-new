# Copy to .env and fill in. NEVER commit .env (it is git-ignored).

PORT=8080
DB_PATH=./data/ctwa.sqlite
# Day boundaries for reports, minutes from UTC (IST = 330)
REPORT_TZ_OFFSET_MIN=330
# Bearer token needed for GET /report (endpoint is disabled if empty)
REPORT_TOKEN=

# --- WhatsApp Cloud API webhook ---
WA_VERIFY_TOKEN=            # any random string you also enter in the Meta app webhook config
WA_APP_SECRET=              # Meta app secret, used to verify X-Hub-Signature-256

# --- Shopify ---
SHOPIFY_WEBHOOK_SECRET=     # app client secret, verifies X-Shopify-Hmac-SHA256
SHOPIFY_SHOP_DOMAIN=        # e.g. yourstore.myshopify.com  (also checked against X-Shopify-Shop-Domain)
SHOPIFY_ADMIN_TOKEN=        # optional: lets us add the CTWA tag to the order (needs write_orders)
SHOPIFY_API_VERSION=2026-10
# "Order confirmed" rule. Use ONE of:
CONFIRM_FINANCIAL_STATUSES=paid,partially_paid
CONFIRM_TAG=                # if set, ONLY this tag (e.g. Confirmed) marks an order confirmed (COD flow)

# --- Meta ---
META_ACCESS_TOKEN=          # system-user token: whatsapp_business_manage_events + ads_read
META_ADS_ACCESS_TOKEN=      # optional: separate token with ads_read on the ad accounts (when they are in another business portfolio)
META_GRAPH_VERSION=v21.0    # docs example shows v16.0; use a current version you have verified
META_DATASET_ID=            # run: node src/cli.js dataset  (asks Meta for the WABA dataset), or pick one in Events Manager
META_WABA_ID=               # WhatsApp Business Account id
META_AD_ACCOUNT_IDS=        # numeric ids, comma separated, e.g. 1026815302613360,2350605891988485
META_PARTNER_AGENT=TMPerfumehouse-CTWA
META_TEST_EVENT_CODE=       # optional: Events Manager "Test events" code; remove in production
META_CONVERSATION_ACTION_TYPE=onsite_conversion.messaging_conversation_started_7d

ATTRIBUTION_WINDOW_DAYS=7
SYNC_INTERVAL_MIN=60        # 0 disables the background spend sync / CAPI retry loop

# Optional: which campaign / ad names are click-to-WhatsApp ads (regular expression). Default: the name starts with WhatsApp or CTWA.
CTWA_AD_NAME_MATCH=

# The new PHP store's orders (read-only key with the read_orders scope, from Settings > API keys)
TMPH_API_KEY=
TMPH_API_BASE=https://tmperfumehouse.com/api/v1
